<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app is light-only (SPEC 8), so the same themes apply in dark mode. -->
    <!-- While the app starts: the navy splash with the gold check. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the Flutter UI while it initialises: navy, so there is no white flash. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
