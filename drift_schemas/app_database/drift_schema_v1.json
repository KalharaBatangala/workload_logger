  "fixed_sql": [
    {
      "name": "profile",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"staff_name\" TEXT NOT NULL, \"display_name\" TEXT NOT NULL, \"academic_year_label\" TEXT NOT NULL, \"workbook_file_name\" TEXT NULL, \"imported_at\" INTEGER NULL, \"submission_date\" TEXT NULL, \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), \"is_demo\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_demo\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "rates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"rates\" (\"key\" TEXT NOT NULL, \"label\" TEXT NOT NULL, \"hours\" REAL NOT NULL, \"source_cell\" TEXT NULL, \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "role_rows",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"role_rows\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"module_code\" TEXT NOT NULL, \"batch\" TEXT NOT NULL, \"module_name\" TEXT NOT NULL, \"module_type\" TEXT NOT NULL, \"credits\" REAL NOT NULL DEFAULT 0.0, \"students\" INTEGER NOT NULL DEFAULT 0, \"role\" TEXT NOT NULL, \"sheet_row\" INTEGER NULL, \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"is_demo\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_demo\" IN (0, 1)), UNIQUE (\"module_code\", \"batch\", \"role\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"role_row_id\" INTEGER NULL REFERENCES role_rows (id), \"date\" TEXT NOT NULL, \"activity\" TEXT NOT NULL, \"subtype\" TEXT NULL, \"count\" REAL NULL, \"questions_per_paper\" REAL NULL, \"spent_minutes\" INTEGER NULL, \"note\" TEXT NULL, \"status\" TEXT NOT NULL, \"source\" TEXT NOT NULL, \"raw_text\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"is_demo\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_demo\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entry_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entry_photos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"entry_id\" TEXT NOT NULL REFERENCES entries (id) ON DELETE CASCADE, \"file_path\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "other_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"other_categories\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "other_work",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"other_work\" (\"id\" TEXT NOT NULL, \"date\" TEXT NOT NULL, \"category_id\" INTEGER NOT NULL REFERENCES other_categories (id), \"spent_minutes\" INTEGER NOT NULL, \"note\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"is_demo\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_demo\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
